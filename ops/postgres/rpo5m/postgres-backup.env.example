# Copy to: /etc/gog/postgres-backup.env

# DB connection for pg_basebackup
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-me

# Backup destinations
GOG_WAL_ARCHIVE_DIR=/var/backups/gog/postgres/wal
GOG_BASEBACKUP_DIR=/var/backups/gog/postgres/base

# Optional settings
GOG_WAL_COMPRESS=1
GOG_BASEBACKUP_RETENTION_DAYS=14
GOG_RPO_SECONDS=300
